		"autoprefixer": "^10.4.16",
		"postcss": "^8.4.32",
		"super-sitemap": "^1.0.3",
		"svelte": "^5.35.2",
		"svelte-check": "^4.2.2",
		"tailwindcss": "^3.4.14",
		"tslib": "^2.8.1",
		"typescript": "^5.6.3",
		"ui": "*",
		"vite": "^5.4.10"
	},
	"dependencies": {
		"bits-ui": "^2.14.2",
