{
	"name": "web",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "cross-env VITE_CORES_MODE=client VITE_URL=http://localhost:3001 VITE_LOGIN=true vite dev --port 3001",
		"build": "cross-env VITE_CORES_MODE=client VITE_URL=http://localhost:3001 VITE_LOGIN=true vite build",
		"build:web": "cross-env VITE_CORES_MODE=client VITE_URL=https://www.coresmonitor.com VITE_LOGIN=true vite build",
		"build:docker": "VITE_CORES_MODE=client VITE_URL=http://localhost:3000 vite build",
