{
	"compilerOptions": {
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		/* "noUncheckedIndexedAccess": true, */
		"declaration": true,
		"composite": true,
		"declarationMap": true,
		"module": "esnext",
		"noEmit": true,
		"lib": ["ESNext", "dom", "dom.iterable"]
	}
}
