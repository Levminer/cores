<Project Sdk="Microsoft.NET.Sdk.Worker">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>CoresService</AssemblyName>
		<ApplicationIcon>Assets\icon.ico</ApplicationIcon>
		<PublishProfile>win10-x64.pubxml</PublishProfile>
		<Version>0.43.0</Version>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Assets\icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="H.NotifyIcon" Version="2.4.1" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
		<PackageReference Include="Sentry" Version="6.9.0" />
		<PackageReference Include="ezrtc" Version="0.15.0" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\lib\lib.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<SentryOrg>levminer</SentryOrg>
		<SentryProject>cores_service</SentryProject>
		<SentryUploadSymbols>true</SentryUploadSymbols>
		<SentryUploadSources>true</SentryUploadSources>
	</PropertyGroup>
</Project>
